# DeepSeek API configuration for Dictionary Explanation AI feature
# Copy this file to '.env' in this directory and replace 'your_deepseek_api_key_here' with your real API key.
# Note: Keep the 'VITE_' prefix so that Vite can expose it to the React application.

VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_MODEL=